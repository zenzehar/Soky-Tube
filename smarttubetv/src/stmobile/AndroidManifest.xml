<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Mobile preview only: clean installs must not silently restore old
         preferences from Android Backup, which obscures crash diagnosis. -->
    <application android:allowBackup="false"
        tools:replace="android:allowBackup">
        <!-- Handheld player follows Android's recommended single-task PiP model
             instead of the inherited TV singleInstance activity task. -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.playback.PlaybackActivity"
            android:launchMode="singleTask"
            android:showWhenLocked="false"
            android:turnScreenOn="false"
            tools:replace="android:launchMode,android:showWhenLocked" />
    </application>
</manifest>
