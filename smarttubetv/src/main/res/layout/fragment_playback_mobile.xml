<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_watch_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">
    <FrameLayout
        android:id="@+id/mobile_player_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">
        <fragment
            android:id="@+id/playback_controls_fragment"
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.playback.PlaybackFragment"
            android:tag="@string/playback_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mobile_watch_below"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF" />
</LinearLayout>
